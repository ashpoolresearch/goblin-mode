CLAUDE_PID=""

kill_claude() {
  if [[ -n "$CLAUDE_PID" ]] && kill -0 "$CLAUDE_PID" 2>/dev/null; then
    kill "$CLAUDE_PID" 2>/dev/null
    wait "$CLAUDE_PID" 2>/dev/null || true
    CLAUDE_PID=""
  fi
}

# Read a keypress, handling escape sequences. Sets TUI_KEY.
# Returns 1 if no key was pressed within the timeout.
read_tui_key() {
  TUI_KEY=""
  local key
  read -rsn1 -t 0.5 key || return 1
  if [[ "$key" == $'\x1b' ]]; then
    read -rsn2 -t 0.1 key || true
  fi
  TUI_KEY="$key"
  return 0
}

# Handle a keypress during the run loop. Returns:
#   0 = handled, continue
#   10 = back to settings
#   11 = quit
handle_run_key() {
  local key="$1"
  case "$key" in
    p|P) [[ "$PAUSED" == "true" ]] && PAUSED=false || PAUSED=true ;;
    s|S) return 10 ;;
    q|Q) return 11 ;;
  esac
  return 0
}

tui_run_loop() {
  STATUS_LINES=()
  LAST_RENDERED=""
  tput clear

  while true; do
    # Handle pause — block on input until unpaused
    while [[ "$PAUSED" == "true" ]]; do
      draw_running_screen
      if read_tui_key; then
        handle_run_key "$TUI_KEY" || {
          local rc=$?
          kill_claude
          [[ $rc -eq 10 ]] && return 0
          return 1
        }
      fi
    done

    ITERATION=$((ITERATION + 1))
    STATUS_LINES=()
    STATUS_LINES+=("${CYAN}> Starting iteration ${ITERATION}...${RESET}")
    STATUS_LINES+=("${DIM}> Assessing system, picking task, implementing...${RESET}")
    draw_running_screen

    # Run Claude in background so we can handle input
    local tmpfile
    tmpfile=$(mktemp)
    run_iteration_cmd > "$tmpfile" 2>&1 &
    CLAUDE_PID=$!

    local dots=0
    local last_line_count=0
    # Poll for completion + input
    while kill -0 "$CLAUDE_PID" 2>/dev/null; do
      if read_tui_key; then
        handle_run_key "$TUI_KEY" || {
          local rc=$?
          kill_claude
          rm -f "$tmpfile"
          [[ $rc -eq 10 ]] && return 0
          return 1
        }
      fi

      # Update status area
      dots=$(( (dots + 1) % 4 ))
      local anim=""
      for ((d=0; d<dots; d++)); do anim+="."; done

      if [[ "$CFG_VERBOSE" == "true" && -f "$tmpfile" ]]; then
        # Show live output from Claude in the status area
        local current_lines
        current_lines=$(wc -l < "$tmpfile" 2>/dev/null || echo 0)
        ((current_lines > last_line_count)) && last_line_count=$current_lines
        # Always rebuild with current animation tick and latest tail lines
        STATUS_LINES=("${CYAN}> Iteration ${ITERATION} running${anim}${RESET}")
        while IFS= read -r line; do
          [[ ${#line} -gt 60 ]] && line="${line:0:57}..."
          [[ -n "$line" ]] && STATUS_LINES+=("${DIM}  ${line}${RESET}")
        done < <(tail -5 "$tmpfile" 2>/dev/null)
      else
        STATUS_LINES=("${CYAN}> Iteration ${ITERATION} running${anim}${RESET}")
      fi

      if [[ "$PAUSED" == "true" ]]; then
        STATUS_LINES+=("${YELLOW}> Paused (Claude still finishing current task)${RESET}")
      fi
      draw_running_screen
    done

    wait "$CLAUDE_PID" 2>/dev/null || true
    CLAUDE_PID=""

    local output
    output=$(cat "$tmpfile")
    rm -f "$tmpfile"

    # Parse results
    local task result validation usage notes
    task=$(extract_field "$output" "TASK")
    result=$(extract_field "$output" "RESULT")
    validation=$(extract_field "$output" "VALIDATION")
    usage=$(extract_field "$output" "USAGE")
    notes=$(extract_field "$output" "NOTES")

    # Update status
    STATUS_LINES=()
    local rc="${GREEN}"; [[ "$result" == *partial* ]] && rc="${YELLOW}"; [[ "$result" == *failure* ]] && rc="${RED}"
    STATUS_LINES+=("${BOLD}> Task: ${task}${RESET}")
    STATUS_LINES+=("${rc}> Result: ${result}${RESET}")
    [[ -n "$validation" ]] && STATUS_LINES+=("${GREEN}> Validated: ${validation}${RESET}")
    [[ -n "$usage" ]] && STATUS_LINES+=("${BLUE}> Usage: ${usage}${RESET}")
    [[ -n "$notes" && "$notes" != "none" ]] && STATUS_LINES+=("${YELLOW}> Notes: ${notes}${RESET}")

    add_history "$result" "$task" "$validation" "$usage"
    log_iteration "$output"
    draw_running_screen

    # Check for done
    if check_done "$output"; then
      STATUS_LINES+=("")
      STATUS_LINES+=("${GREEN}${BOLD}> Server fully evolved!${RESET}")
      draw_running_screen
      read -rsn1 || true
      return 1
    fi

    # If paused during iteration, stay paused for next loop
  done
}

tui_loop() {
  tui_init
  get_term_size

  # Skip settings if --go was passed
  if [[ "${CFG_AUTO_START:-false}" != "true" ]]; then
    while true; do
      if ! settings_loop; then
        tui_cleanup
        echo "Goblin mode cancelled."
        return
      fi

      # Run, then loop back to settings or quit
      if ! tui_run_loop; then
        tui_cleanup
        print_summary
        return
      fi
      # tui_run_loop returned 0 = back to settings
    done
  else
    # Auto-start: go straight to running
    if ! tui_run_loop; then
      tui_cleanup
      print_summary
      return
    fi
    tui_cleanup
    print_summary
  fi
}

# ============================================================
#  WRAPUP
# ============================================================

print_summary() {
  echo ""
  echo "  ${BOLD}${GREEN}GOBLIN MODE COMPLETE${RESET}"
  echo "  Iterations: $ITERATION"
  echo "  Logs: $CFG_LOG_DIR/"
  echo ""
}

cleanup() {
  kill_claude
  stop_spinner
  if [[ "$CFG_HEADLESS" != "true" ]]; then
    tui_cleanup
  fi
  print_summary
  exit 0
}

# ============================================================
#  ENTRY POINT
# ============================================================

main() {
  load_config
  parse_args "$@"
  setup_colors

  # Validate selected mode exists
  if [[ -z "${MODE_PROMPTS[$CFG_MODE]+x}" ]]; then
    echo "Error: unknown mode '$CFG_MODE'"
    echo "Available modes: ${MODE_NAMES[*]}"
    exit 1
  fi

  mkdir -p "$CFG_LOG_DIR"
  trap cleanup SIGINT SIGTERM

  if [[ "$CFG_HEADLESS" == "true" ]]; then
    headless_loop
  else
    tui_loop
  fi
}

main "$@"
